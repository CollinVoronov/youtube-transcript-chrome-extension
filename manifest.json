{
  "manifest_version": 3,
  "name": "YouTube Transcript & Insights",
  "version": "1.1.0",
  "description": "Extract YouTube transcripts and get an AI summary that starts generating the moment a video opens: a full section-by-section breakdown and quotes you can star and jump to.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://api.supadata.ai/*",
    "https://api.anthropic.com/*",
    "https://api.cursor.com/*",
    "https://api2.cursor.sh/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YouTube Transcript & Insights",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
